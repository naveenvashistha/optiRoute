# Copy this file to backend/.env and supply your own credentials.
# The application does not load .env.example automatically.
# On a server, these values can instead be supplied as environment variables.

# Application logs: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# Server access logs and third-party library verbosity are configured separately.
LOG_LEVEL=INFO

# Provider selection: SLM_PROVIDER = groq or ollama.
# CLOUD_PROVIDER = gemini, openai, or groq.
SLM_PROVIDER=groq
CLOUD_PROVIDER=gemini

# Credentials: never commit real keys to this template.
# Groq is required by the current cloud routing, including its fallback path.
GROQ_API_KEY=
# Required when CLOUD_PROVIDER=gemini.
GEMINI_API_KEY=
# Required when CLOUD_PROVIDER=openai.
OPENAI_API_KEY=

# Hosted model names. These match the application's current defaults.
GROQ_SLM_MODEL=openai/gpt-oss-20b
GROQ_CLOUD_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-4o-mini

# Ollama settings, used when SLM_PROVIDER=ollama.
# Change the address if Ollama runs on another host or in another container.
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3.2:3b
OLLAMA_NUM_CTX=4096

# Redis must provide Redis Search/vector search support.
# localhost is for a backend running on the host machine.
# With a Compose service named redis, a containerized backend uses redis://redis:6379.
REDIS_URL=redis://localhost:6379
REDIS_INDEX_NAME=query_cache_idx
REDIS_KEY_PREFIX=cache

# Expiration values are in seconds. Sessions expire after 24 hours of inactivity.
CACHE_TTL=3600
REDIS_SESSION_TTL=86400

# Embedding and classifier settings.
VECTOR_DIMENSION=384
SIMILARITY_THRESHOLD=0.10
INTENT_THRESHOLD=0.97

# Optional model path overrides. Leave unset to use backend/models automatically.
# Paths must refer to files/directories available to the running backend.
# MODEL_PATH=/absolute/path/to/intent_mlp_model.joblib
# ROUTER_MODEL_PATH=/absolute/path/to/optiroute_router_model

# Baseline prices per million tokens for estimated savings.
PRICE_PER_1M_INPUT_TOKENS=0.150
PRICE_PER_1M_OUTPUT_TOKENS=0.600
